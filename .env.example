# =====================================================================
#             КОНФИГУРАЦИЯ TELEGRAM БОТА И НЕЙРОСЕТИ
# =====================================================================

# Токен вашего Telegram бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Провайдер нейросети: 'openai' (подходит для OpenAI, DeepSeek, OpenRouter, ProxyAPI) или 'gemini'
LLM_PROVIDER=openai

# ---------------------------------------------------------------------
# Вариант 1: Настройки для OpenAI / DeepSeek / OpenRouter / Прокси
# ---------------------------------------------------------------------
LLM_API_KEY=your_api_key_here

# Базовый URL API (для стандартного OpenAI оставьте по умолчанию)
# Для DeepSeek: https://api.deepseek.com/v1
# Для OpenRouter: https://openrouter.ai/api/v1
# Для ProxyAPI: https://api.proxyapi.ru/openai/v1
LLM_BASE_URL=https://api.openai.com/v1

# Модель (например: gpt-4o, deepseek-chat, anthropic/claude-3.5-sonnet)
LLM_MODEL=gpt-4o

# ---------------------------------------------------------------------
# Вариант 2: Настройки для прямого Google Gemini
# (активируется, если LLM_PROVIDER=gemini)
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
